# ==============================================================================
# Case Connect AI - Environment Variable Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit the actual .env file with production credentials to source control.

# Application Server
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Databases
DATABASE_URL=sqlite:///./app.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# Security & Authentication
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Storage
UPLOAD_DIR=./uploads

# AI Engine (Google Gemini - Optional / Zero-Cloud Fallback)
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# Forensic OCR & Media Binaries (Optional local paths)
TESSERACT_CMD=CHANGE_ME_OPTIONAL_TESSERACT_PATH
FFMPEG_CMD=CHANGE_ME_OPTIONAL_FFMPEG_PATH
FFMPEG_BINARY=CHANGE_ME_OPTIONAL_FFMPEG_PATH

# Frontend Client
VITE_API_URL=/api
